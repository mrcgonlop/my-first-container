    },
    "ace_ventura": {
      "name": "Ace Ventura: When Nature Calls",
      "type": "wine",
      "category": "games",
      "command": "ACEVENT.EXE",
      "args": "",
      "path_relative_to_data": "games/ace_ventura",
      "description": "Adventure game (Win95)"
    },
    "encarta_2000": {
      "name": "Microsoft Encarta 2000",
      "type": "wine",
      "category": "apps",
      "command": "Encarta.exe",
      "args": "",
      "path_relative_to_data": "apps/encarta_2000",
      "description": "Interactive encyclopedia (Win98)"
    },
    "encarta_2005": {
      "name": "Microsoft Encarta 2005",
      "type": "wine",
      "category": "apps",
      "command": "program/Biblioteca de Consulta Encarta 2005/Encarta.exe",
      "args": "",
      "path_relative_to_data": "apps/encarta_2005",
