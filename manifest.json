    "encarta_2005_setup": {
      "name": "Encarta 2005 (setup)",
      "type": "wine",
      "category": "apps",
      "command": "install.cmd",
      "args": "",
      "path_relative_to_data": "apps/encarta_2005",
      "description": "Installs the 4 CDs into data/apps/encarta_2005/program (elevation prompt, ~2 GB)"
    },
    "doom_dos": {
      "name": "Doom (DOS)",
      "type": "dosbox",
      "category": "games",
      "path_relative_to_data": "games/doom",
      "mount": "C",
      "command": "DOOM.EXE",
      "args": "-iwad DOOM1.WAD",
      "config": "dosbox.conf",
      "description": "Classic FPS (DOS)"
    },
    "wolf3d_dos": {
      "name": "Wolfenstein 3D (DOS)",
      "type": "dosbox",
      "category": "games",
      "path_relative_to_data": "games/wolf3d",
